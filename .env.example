# Neon — pooled (app en runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon — direct / unpooled (Prisma CLI: db push, migrate)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Número de WhatsApp oficial de la tienda (formato internacional sin signos)
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"

# Contraseña del panel /admin (no la subas a Git)
ADMIN_PASSWORD="cambia-esta-clave"

# URL pública del sitio. En Vercel: https://TU-PROYECTO.vercel.app (con https, sin barra al final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opcional: Google Analytics 4 (solo se carga si está definido, ej. G-XXXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Opcional: código de verificación de Google Search Console (meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
